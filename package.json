{
  "name": "dsh-finish-notify",
  "version": "0.5.3",
  "description": "DSH 请求完成后在屏幕角落弹出提醒框，点击回到 DSH",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.5": "compatible"
      }
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "icon": "assets/logo.png",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "notification",
    "toast",
    "cordis"
  ],
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SSSSjll/dsh-notify.git"
  },
  "homepage": "https://github.com/SSSSjll/dsh-notify#readme",
  "bugs": {
    "url": "https://github.com/SSSSjll/dsh-notify/issues"
  },
  "author": "SSSSjll"
}